# Copy to .env and fill in your Kotak Neo API credentials. Never commit .env.
CONSUMER_KEY=your-consumer-key
MOBILE_NUMBER=+91XXXXXXXXXX
UCC=YOURUCC
MPIN=123456

# Zerodha Kite (order placement from the charts; optional). From your app at https://developers.kite.trade;
# its redirect URL must be https://127.0.0.1:8765/callback. See kite/README.md.
KITE_API_KEY=
KITE_API_SECRET=
# Optional: KITE_PRODUCT=NRML (or MIS) for the Sell buttons; the algo always uses MIS
# Optional: send orders through kite-route.php on a server with a static IP (see kite/README.md).
# KITE_RELAY_SECRET: 64 random hex characters, e.g. from `python3 -c "import secrets; print(secrets.token_hex(32))"`.
KITE_ORDER_RELAY=
KITE_RELAY_SECRET=
